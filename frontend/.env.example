# ============================================================
# SmartRail Mumbai — Frontend Environment Configuration
# ============================================================
# All variables are completely OPTIONAL!
# The frontend runs 100% out of the box with zero configuration,
# utilizing realistic client-side transit simulation & offline Mumbai dataset.

# Optional: URL of the SmartRail Backend API server (e.g., http://localhost:5000)
# If left empty, the frontend runs independently using its zero-dependency fallback routes.
NEXT_PUBLIC_BACKEND_URL=

# Optional: Google OAuth Client ID for One-Tap Sign In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

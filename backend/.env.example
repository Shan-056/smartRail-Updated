# Port for backend server (defaults to 5000)
PORT=5000
NODE_ENV=development

# MongoDB connection string (Optional: if omitted, backend operates in offline zero-dependency mode)
MONGO_URI=mongodb://localhost:27017/smartrail

# JWT secret key for token authentication
JWT_SECRET=mumbai_smartrail_development_jwt_secret_key_2026

# Google Gemini API key for operations control room AI advisory (Optional)
GEMINI_API_KEY=

# External Fast-API ML prediction engine URL (Optional)
AI_ENGINE_URL=http://localhost:8000

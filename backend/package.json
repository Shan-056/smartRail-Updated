{
  "name": "smartrail-twin-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for AI-powered Passenger Digital Twin and Dynamic ETA Engine — Mumbai Suburban Network (Next.js + TypeScript)",
  "scripts": {
    "dev": "ts-node -r dotenv/config -r tsconfig-paths/register --transpile-only server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production ts-node -r dotenv/config -r tsconfig-paths/register --transpile-only server.ts",
    "seed": "ts-node -r dotenv/config -r tsconfig-paths/register --transpile-only scripts/seed.ts",
    "lint": "next lint"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  }
}
